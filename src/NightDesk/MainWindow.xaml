<Window x:Class="NightDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NightDesk · 屏幕与远程工作台" Icon="Assets/nightdesk.ico" Width="1000" Height="900" MinWidth="840" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#111817" Foreground="#E6EEEA" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#1B2522"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#D2EE9A"/><Setter Property="Foreground" Value="#172018"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#101815"/><Setter Property="Foreground" Value="#E6EEEA"/><Setter Property="BorderBrush" Value="#4B5A50"/><Setter Property="SelectionBrush" Value="#66854D"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Padding" Value="22"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#34443B"/><Setter Property="Foreground" Value="#E6EEEA"/></Style>
 </Window.Resources>
 <DockPanel Margin="28,24">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="NIGHTDESK" FontFamily="Consolas" FontSize="14" Foreground="#D2EE9A"/><TextBlock Text="离开屏幕，保持连接。" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
   <Border Grid.Column="1" CornerRadius="18" Background="#25372A" Padding="15,10" VerticalAlignment="Center"><TextBlock x:Name="ModeLabel" Text="● 本地显示" Foreground="#D2EE9A"/></Border>
  </Grid>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,14,0,0" Foreground="#ABBEB1" Text="准备就绪。关闭窗口后仍驻留系统托盘。"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="01 / 显示模式" Foreground="#A6B5AA" FontFamily="Consolas" FontSize="12"/>
     <TextBlock Text="物理屏幕熄灭 · 虚拟桌面接管" FontSize="20" Margin="0,10,0,6"/>
     <TextBlock Text="保存当前布局后切换到 Parsec 虚拟屏幕；点亮时恢复。应用需保持运行。" Foreground="#ACBCAF"/>
     <WrapPanel Margin="0,18,0,0"><Button x:Name="ToggleButton" Click="Toggle_Click" Content="熄灭物理屏幕 →"/><Button Style="{StaticResource Secondary}" Click="Restore_Click" Content="恢复保存布局"/><Button Style="{StaticResource Secondary}" Click="Refresh_Click" Content="刷新状态"/></WrapPanel>
     <CheckBox x:Name="SleepBox" Content="保持电脑唤醒（允许显示器关闭）" Foreground="#E6EEEA" Margin="0,20,0,0" Click="Sleep_Click"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="02 / 虚拟显示器" Foreground="#A6B5AA" FontFamily="Consolas" FontSize="12"/>
     <Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="宽度 px" Margin="0,0,0,6"/><TextBox x:Name="WidthBox" AutomationProperties.Name="宽度" Text="1920"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="高度 px" Margin="0,0,0,6"/><TextBox x:Name="HeightBox" AutomationProperties.Name="高度" Text="1080"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="刷新率 Hz" Margin="0,0,0,6"/><TextBox x:Name="RefreshBox" AutomationProperties.Name="刷新率" Text="60"/></StackPanel>
      <Button Grid.Column="3" Click="SaveMode_Click" Content="保存默认值" VerticalAlignment="Bottom" Style="{StaticResource Secondary}"/>
     </Grid>
     <TextBlock Foreground="#ACBCAF" Text="按 Parsec VDD 实际支持情况应用。常用：1920×1080 / 2560×1440 / 3840×2160，60 / 144 Hz。"/>
     <ListBox x:Name="DisplayList" MinHeight="64" MaxHeight="150" Margin="0,12,8,12" Background="#101815" Foreground="#E6EEEA" BorderBrush="#34443B" DisplayMemberPath="Mode" AutomationProperties.Name="本程序创建的虚拟显示器"/>
     <WrapPanel><Button Click="Add_Click" Content="＋ 添加显示器"/><Button Click="Remove_Click" Content="删除所选显示器" Style="{StaticResource Secondary}"/></WrapPanel>
     <Button x:Name="InstallDriverButton" Click="InstallDriver_Click" Content="安装 Parsec VDD 驱动" Style="{StaticResource Secondary}" Margin="0,10,8,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
     <TextBlock x:Name="DriverHint" Foreground="#D5C88F" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="03 / 全局快捷键" Foreground="#A6B5AA" FontFamily="Consolas" FontSize="12"/>
     <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Click="Hotkey_Click" Content="应用快捷键" Style="{StaticResource Secondary}"/><TextBox x:Name="HotkeyBox" Text="Ctrl+Alt+F10" AutomationProperties.Name="全局快捷键"/></DockPanel>
     <TextBlock Text="切换熄屏与点亮。支持 Ctrl / Alt / Shift / Win 加字母、数字或 F1–F12。" Foreground="#ACBCAF" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="04 / TAILSCALE 远程控制" Foreground="#A6B5AA" FontFamily="Consolas" FontSize="12"/>
     <TextBlock x:Name="RemoteLabel" Text="远程控制未启用" FontSize="18" Margin="0,12,0,6"/>
     <TextBox x:Name="UrlBox" IsReadOnly="True" AutomationProperties.Name="远程 HTTPS 地址" Text="正在读取本机 Tailscale 地址…"/>
     <WrapPanel Margin="0,12,0,0"><Button x:Name="RemoteButton" Click="Remote_Click" Content="启用 HTTPS 远程控制"/><Button Click="CopyToken_Click" Content="复制兼容令牌" Style="{StaticResource Secondary}"/><Button Click="RotateToken_Click" Content="重置兼容令牌" Style="{StaticResource Secondary}"/></WrapPanel>
     <TextBlock Text="仅限已连接 Tailscale 且受 ACL 允许的设备。推荐用 Android 扫码绑定；每个设备获得独立长期令牌，直到在此处删除绑定。" Foreground="#ACBCAF" Margin="0,12,0,0"/>
     <Border Background="#101815" CornerRadius="8" Padding="14" Margin="0,16,0,0"><StackPanel>
      <TextBlock Text="受信任设备" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock x:Name="DeviceCountLabel" Text="尚无已绑定设备" Foreground="#A6B5AA" Margin="0,4,0,10"/>
      <ListBox x:Name="TrustedDeviceList" MinHeight="92" MaxHeight="190" Background="#17211E" Foreground="#E6EEEA" BorderBrush="#34443B" SelectionChanged="DeviceList_SelectionChanged">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedText}" Foreground="#A6B5AA" FontSize="12"/><TextBlock Text="{Binding ActivityText}" Foreground="#8FA79A" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="PairQrButton" Click="PairQr_Click" Content="扫描二维码绑定"/><Button x:Name="DeviceRefreshButton" Click="RefreshDevices_Click" Content="刷新设备" Style="{StaticResource Secondary}"/><Button x:Name="RevokeDeviceButton" Click="RevokeDevice_Click" Content="删除所选绑定" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel>
      <TextBlock Text="二维码只包含 5 分钟有效的一次性配对票据，不含设备长期令牌。删除绑定后，该设备的下一次请求立即返回 401。" Foreground="#8FA79A" FontSize="12" Margin="0,10,0,0"/>
     </StackPanel></Border>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="05 / 低带宽远程控制 (GO-NX)" Foreground="#A6B5AA" FontFamily="Consolas" FontSize="12"/>
     <TextBlock Text="QUIC + 无损瓦片差分 · 适合文字与静态界面" FontSize="20" Margin="0,10,0,6"/>
     <TextBlock Text="与 04 区 Tailscale HTTPS 面板相互独立：本区直接传输屏幕瓦片和输入事件，不经过浏览器。默认关闭，启用后本机立即开始屏幕采集与输入注入。" Foreground="#ACBCAF"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="监听地址 (UDP)" Margin="0,0,0,6"/><TextBox x:Name="NxListenBox" Text="127.0.0.1:7000" AutomationProperties.Name="远控监听地址"/></StackPanel>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="显示器" Margin="0,0,0,6"/><TextBox x:Name="NxDisplayBox" Text="primary" AutomationProperties.Name="远控显示器"/></StackPanel>
      <StackPanel><TextBlock Text="帧率" Margin="0,0,0,6"/><TextBox x:Name="NxFpsBox" Text="10" AutomationProperties.Name="远控帧率"/></StackPanel>
     </Grid>
     <TextBlock Text="显示器可填 primary、从 0 开始的索引或 \\.\\DISPLAYn。生产环境请监听 Tailscale 地址（例如 100.x.y.z:7000），不要直接暴露公网 UDP。" Foreground="#8FA79A" FontSize="12" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,14,0,0">
      <Button x:Name="NxEnableButton" Click="NxEnable_Click" Content="启用低带宽远控"/>
      <Button x:Name="NxTailscaleButton" Click="NxTailscale_Click" Content="填入 Tailscale 地址" Style="{StaticResource Secondary}"/>`r`n      <Button x:Name="NxPairButton" Click="NxPair_Click" Content="生成配对二维码" Style="{StaticResource Secondary}" IsEnabled="False"/>
      <Button x:Name="NxRefreshButton" Click="NxRefresh_Click" Content="刷新设备" Style="{StaticResource Secondary}" IsEnabled="False"/>
     </WrapPanel>
     <Border Background="#101815" CornerRadius="8" Padding="14" Margin="0,14,0,0"><StackPanel>
      <TextBlock x:Name="NxStatusLabel" Text="远控未启用" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock x:Name="NxPeerLabel" Text="无客户端连接" Foreground="#A6B5AA" Margin="0,4,0,0"/>
      <TextBlock x:Name="NxCodeLabel" Text="尚未生成配对码" Foreground="#D2EE9A" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <TextBlock Text="受信任设备（证书指纹）" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <ListBox x:Name="NxTrustedList" MinHeight="70" MaxHeight="150" Background="#101815" Foreground="#E6EEEA" BorderBrush="#34443B" SelectionChanged="NxDeviceList_SelectionChanged" AutomationProperties.Name="go-nx 受信任设备">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Display}" FontFamily="Consolas"/><TextBlock Text="{Binding PairedAt}" Foreground="#8FA79A" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Margin="0,10,0,0"><Button x:Name="NxUntrustButton" Click="NxUntrust_Click" Content="解除所选设备信任" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel>
     <TextBlock Text="配对码 5 分钟有效且仅能绑定一台新设备；连续 5 次错误会锁定 1 分钟。sidecar 退出或 NightDesk 崩溃时，Windows Job Object 会一并终止它。" Foreground="#8FA79A" FontSize="12" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Expander Header="当前显示设备 / 诊断" Foreground="#ACBCAF" Margin="3,4,0,8"><TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas"/></Expander>
    <Button Content="退出 NightDesk" Click="Exit_Click" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,8,8,0"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>


