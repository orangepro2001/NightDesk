<Window x:Class="NightDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NightDesk · 屏幕与远程工作台" Icon="Assets/nightdesk.ico" Width="1180" Height="900" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#111817" Foreground="#E6EEEA" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#1B2522"/>
  <SolidColorBrush x:Key="PanelDeep" Color="#101815"/>
  <SolidColorBrush x:Key="Muted" Color="#A6B5AA"/>
  <SolidColorBrush x:Key="Hint" Color="#8FA79A"/>
  <SolidColorBrush x:Key="Accent" Color="#D2EE9A"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#D2EE9A"/><Setter Property="Foreground" Value="#172018"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#34443B"/><Setter Property="Foreground" Value="#E6EEEA"/></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#6B3B3B"/><Setter Property="Foreground" Value="#F4DEDA"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="Background" Value="#0D1512"/><Setter Property="Foreground" Value="#E6EEEA"/><Setter Property="BorderBrush" Value="#4B5A50"/><Setter Property="SelectionBrush" Value="#66854D"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="38"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6EEEA"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0D1512"/><Setter Property="Foreground" Value="#E6EEEA"/><Setter Property="BorderBrush" Value="#34443B"/><Setter Property="Padding" Value="6"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Padding" Value="22"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="InnerCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelDeep}"/><Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
  <Style x:Key="Kicker" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,6"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Hint}"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A6B5AA"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="18,12"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#1B2522"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <DockPanel Margin="26,22,26,18">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="NIGHTDESK" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Accent}"/><TextBlock Text="屏幕与远程工作台" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="显示切换、被控、控制其它桌面与应用更新已分页。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="18" Background="#25372A" Padding="14,9" Margin="0,0,10,0"><TextBlock x:Name="ModeLabel" Text="● 本地显示" Foreground="{StaticResource Accent}"/></Border><Border CornerRadius="18" Background="#26302D" Padding="14,9"><TextBlock x:Name="HeaderVersionLabel" Text="版本 1.6.0" Foreground="{StaticResource Muted}"/></Border></StackPanel>
  </Grid>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,12,0,0" Foreground="#ABBEB1" Text="准备就绪。关闭窗口后仍驻留系统托盘。"/>
  <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <TabItem Header="概览">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="当前状态" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="OverviewSummaryLabel" Text="正在读取显示与远程状态…" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="常用操作集中在此页；屏幕参数、被控、控制其它桌面和更新分别位于上方分页。" Style="{StaticResource HintText}"/>
      <WrapPanel Margin="0,18,0,0"><Button x:Name="ToggleButton" Click="Toggle_Click" Content="熄灭物理屏幕 →"/><Button Click="Restore_Click" Content="恢复保存布局" Style="{StaticResource Secondary}"/><Button Click="Refresh_Click" Content="刷新状态" Style="{StaticResource Secondary}"/></WrapPanel>
      <CheckBox x:Name="SleepBox" Content="保持电脑唤醒（允许显示器关闭）" Click="Sleep_Click" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="状态说明" Style="{StaticResource Kicker}"/>
      <TextBlock Text="• 熄灭物理屏幕会切换到 NightDesk 管理的虚拟显示器。" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
      <TextBlock Text="• 远程网页和低带宽被控是两套独立入口，分别位于“远程访问”页。" Style="{StaticResource HintText}" Margin="0,5,0,0"/>
      <TextBlock Text="• 控制另一台 Windows 使用“控制桌面”页；桌面更新在“更新与诊断”页。" Style="{StaticResource HintText}" Margin="0,5,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="显示">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="显示模式" Style="{StaticResource Kicker}"/>
      <TextBlock Text="物理屏幕与虚拟桌面" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="保存当前布局后切换到 Parsec 虚拟屏幕；点亮时恢复。应用需保持运行。" Style="{StaticResource HintText}"/>
      <WrapPanel Margin="0,18,0,0"><Button Click="Toggle_Click" Content="切换熄屏 / 点亮"/><Button Click="Restore_Click" Content="恢复保存布局" Style="{StaticResource Secondary}"/><Button Click="Refresh_Click" Content="刷新状态" Style="{StaticResource Secondary}"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="虚拟显示器" Style="{StaticResource Kicker}"/>
      <TextBlock Text="分辨率、刷新率与 NightDesk 自有虚拟输出" Style="{StaticResource PageTitle}"/>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,14,0"><TextBlock Text="宽度 px" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WidthBox" AutomationProperties.Name="宽度" Text="1920"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="高度 px" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeightBox" AutomationProperties.Name="高度" Text="1080"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="刷新率 Hz" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RefreshBox" AutomationProperties.Name="刷新率" Text="60"/></StackPanel>
       <StackPanel Grid.Column="3" VerticalAlignment="Bottom"><Button Click="SaveMode_Click" Content="保存默认值" Style="{StaticResource Secondary}" Margin="0,0,0,0"/></StackPanel>
      </Grid>
      <TextBlock Text="本程序创建的虚拟显示器" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
      <ListBox x:Name="DisplayList" MinHeight="74" MaxHeight="160" DisplayMemberPath="Mode" AutomationProperties.Name="本程序创建的虚拟显示器"/>
      <WrapPanel Margin="0,12,0,0"><Button Click="Add_Click" Content="添加虚拟显示器"/><Button Click="Remove_Click" Content="删除所选" Style="{StaticResource Danger}"/><Button x:Name="InstallDriverButton" Click="InstallDriver_Click" Content="安装 Parsec VDD 驱动" Style="{StaticResource Secondary}" Visibility="Collapsed"/></WrapPanel>
      <TextBlock x:Name="DriverHint" Foreground="#D5C88F" FontSize="12" Margin="0,6,0,0"/>
      <TextBlock Text="虚拟屏增删会改变显示拓扑；自动测试不得执行这些操作。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="全局快捷键" Style="{StaticResource Kicker}"/>
      <TextBlock Text="快速切换熄屏 / 点亮" Style="{StaticResource PageTitle}"/>
      <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HotkeyBox" Text="Ctrl+Alt+F10" AutomationProperties.Name="全局快捷键" Margin="0,0,12,0"/><Button Grid.Column="1" Click="Hotkey_Click" Content="应用快捷键" Style="{StaticResource Secondary}" Margin="0"/></Grid>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="远程访问">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Tailscale HTTPS" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="RemoteLabel" Text="远程控制未启用" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="兼容远程网页地址" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
      <TextBox x:Name="UrlBox" IsReadOnly="True" AutomationProperties.Name="远程 HTTPS 地址" Text="正在读取本机 Tailscale 地址…"/>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="RemoteButton" Click="Remote_Click" Content="启用 HTTPS 远程控制"/><Button Click="CopyToken_Click" Content="复制兼容令牌" Style="{StaticResource Secondary}"/><Button Click="RotateToken_Click" Content="重置兼容令牌" Style="{StaticResource Secondary}"/></WrapPanel>
      <TextBlock Text="仅限 tailnet 内、受 ACL 允许且已绑定的设备；不启用 Funnel。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
      <Border Style="{StaticResource InnerCard}"><StackPanel>
       <TextBlock Text="受信任设备" FontWeight="SemiBold" FontSize="16"/>
       <TextBlock x:Name="DeviceCountLabel" Text="尚无已绑定设备" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
       <ListBox x:Name="TrustedDeviceList" MinHeight="92" MaxHeight="190" SelectionChanged="DeviceList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedText}" Foreground="#A6B5AA" FontSize="12"/><TextBlock Text="{Binding ActivityText}" Foreground="#8FA79A" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       <WrapPanel Margin="0,10,0,0"><Button x:Name="PairQrButton" Click="PairQr_Click" Content="扫描二维码绑定"/><Button x:Name="DeviceRefreshButton" Click="RefreshDevices_Click" Content="刷新设备" Style="{StaticResource Secondary}"/><Button x:Name="RevokeDeviceButton" Click="RevokeDevice_Click" Content="删除所选绑定" Style="{StaticResource Danger}" IsEnabled="False"/></WrapPanel>
       <TextBlock Text="二维码只包含 5 分钟有效的一次性票据，不含长期令牌。删除绑定后下一次请求立即 401。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
      </StackPanel></Border>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="本机低带宽被控 (go-nx)" Style="{StaticResource Kicker}"/>
      <TextBlock Text="让手机或另一台桌面控制本机" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="QUIC + 无损 tile 差分，适合文字和静态界面。启用后本机立即开始抓屏和输入注入。" Style="{StaticResource HintText}"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,14,0"><TextBlock Text="监听地址 (UDP)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NxListenBox" Text="127.0.0.1:7000" AutomationProperties.Name="远控监听地址"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="显示器" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NxDisplayBox" Text="primary" AutomationProperties.Name="远控显示器"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="帧率" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NxFpsBox" Text="10" Width="96" AutomationProperties.Name="远控帧率"/></StackPanel>
      </Grid>
      <TextBlock Text="显示器可填 primary、索引或 \\.\\DISPLAYn。生产环境监听 Tailscale 地址，不要直接暴露公网 UDP。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="NxEnableButton" Click="NxEnable_Click" Content="启用低带宽远控"/><Button x:Name="NxTailscaleButton" Click="NxTailscale_Click" Content="填入 Tailscale 地址" Style="{StaticResource Secondary}"/><Button x:Name="NxPairButton" Click="NxPair_Click" Content="生成配对二维码" Style="{StaticResource Secondary}" IsEnabled="False"/><Button x:Name="NxRefreshButton" Click="NxRefresh_Click" Content="刷新设备" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel>
      <Border Style="{StaticResource InnerCard}"><StackPanel><TextBlock x:Name="NxStatusLabel" Text="远控未启用" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="NxPeerLabel" Text="无客户端连接" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="NxCodeLabel" Text="尚未生成配对码" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
      <TextBlock Text="受信任设备（证书指纹）" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
      <ListBox x:Name="NxTrustedList" MinHeight="70" MaxHeight="150" SelectionChanged="NxDeviceList_SelectionChanged" AutomationProperties.Name="go-nx 受信任设备"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Display}" FontFamily="Consolas"/><TextBlock Text="{Binding PairedAt}" Foreground="#8FA79A" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="NxUntrustButton" Click="NxUntrust_Click" Content="解除所选设备信任" Style="{StaticResource Danger}" IsEnabled="False"/></WrapPanel>
      <TextBlock Text="配对码 5 分钟有效且仅能绑定一台新设备；连续 5 次错误锁定 1 分钟。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="控制桌面">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Windows → Windows" Style="{StaticResource Kicker}"/>
      <TextBlock Text="控制另一台 NightDesk 桌面" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="在目标端生成配对信息，然后在这里粘贴地址、6 位配对码和可选主机指纹。首次连接成功后固定证书，后续可留空配对码。" Style="{StaticResource HintText}"/>
      <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="2.3*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,14,0"><TextBlock Text="目标地址 (UDP)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NxViewerAddressBox" AutomationProperties.Name="目标桌面地址" ToolTip="例如 100.x.y.z:7000 或 hostname:7000"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="配对码（6 位）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NxViewerCodeBox" MaxLength="6" AutomationProperties.Name="目标桌面配对码"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="主机指纹（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NxViewerFingerprintBox" AutomationProperties.Name="目标主机证书指纹"/></StackPanel>
      </Grid>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="NxViewerConnectButton" Click="NxViewerConnect_Click" Content="打开桌面控制窗口"/><Button x:Name="NxViewerForgetButton" Click="NxViewerForget_Click" Content="清除已固定指纹" Style="{StaticResource Secondary}"/></WrapPanel>
      <Border Style="{StaticResource InnerCard}"><TextBlock x:Name="NxViewerStatusLabel" Text="尚未连接其它桌面" Foreground="{StaticResource Muted}"/></Border>
      <TextBlock Text="配对码不保存。QUIC 使用 UDP，Tailscale Serve 不能代理数据面；控制窗口当前要求 Windows 11 / Server 2022 或更新版本。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="连接前检查" Style="{StaticResource Kicker}"/>
      <TextBlock Text="目标端必须已完成" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="1. 在“远程访问”页启用低带宽远控。" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
      <TextBlock Text="2. 监听地址使用目标机的 Tailscale 地址，并生成配对二维码。" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
      <TextBlock Text="3. 在目标端配对窗口点击“复制连接信息”。" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="更新与诊断">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="桌面端应用更新" Style="{StaticResource Kicker}"/>
      <TextBlock Text="自动检查、下载并受控安装" Style="{StaticResource PageTitle}"/>
      <TextBlock x:Name="DesktopVersionLabel" Text="当前版本：正在读取…" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="DesktopUpdateStatusLabel" Text="尚未检查更新" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
      <ProgressBar x:Name="DesktopUpdateProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,12,0,0" Visibility="Collapsed"/>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="DesktopUpdateCheckButton" Click="DesktopUpdateCheck_Click" Content="检查桌面更新"/><Button x:Name="DesktopUpdateInstallButton" Click="DesktopUpdateInstall_Click" Content="安装并重启" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel>
      <TextBlock Text="启动时和每 6 小时自动检查并下载；安装前需确认，安装脚本会等待 NightDesk 正常退出后替换主程序与 nx-host.exe。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
      <TextBlock Text="更新源：https://tony-ai-pc-1.tail9f7f1f.ts.net/nightdesk/api/v1/windows-update" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="诊断" Style="{StaticResource Kicker}"/>
      <TextBlock Text="当前显示设备" Style="{StaticResource PageTitle}"/>
      <Expander Header="展开诊断信息" Foreground="{StaticResource Muted}" Margin="0,8,0,0"><TextBox x:Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" Margin="0,10,0,0" FontFamily="Consolas"/></Expander>
      <TextBlock Text="诊断不会主动切换显示器；仍需遵守现场安全门禁。" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="应用" Style="{StaticResource Kicker}"/>
      <TextBlock Text="退出 NightDesk" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="正常退出会先停止 sidecar，并按现有安全规则处理显示恢复。" Style="{StaticResource HintText}"/>
      <Button Content="退出 NightDesk" Click="Exit_Click" Style="{StaticResource Danger}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>